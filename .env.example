# Copy this file to ".env" in the repo root and fill in your key:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# ".env" is git-ignored — never commit a real key.
#
# Meta Model API key, created at https://developer.meta.com (Meta for Developers
# console -> Model API -> API keys). New developer accounts start with free
# signup credits; the game only makes a few small calls per match.
META_API_KEY=

# Optional overrides. The defaults already target Meta's API:
# AI_BASE_URL=https://api.meta.ai/v1
# AI_MODEL=muse-spark-1.1
#
# The endpoint is OpenAI-compatible, so any compatible provider can be used
# as a fallback by pointing AI_BASE_URL / AI_MODEL at it and putting its key
# in META_API_KEY above (or in AI_API_KEY).
